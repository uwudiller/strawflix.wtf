# Optional: enable cross-device watch progress via Vercel KV.
# Create a KV store in Vercel (Storage -> KV) and copy its credentials here.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: override the Torrentio instance (defaults to torrentio.strem.fun).
# TORRENTIO_BASE=https://torrentio.strem.fun

# Optional: subtitles via OpenSubtitles.com.
# Create an account at opensubtitles.com, generate an API key on their site.
OS_API_KEY=
OS_USERNAME=
OS_PASSWORD=

# Optional: extra stream source add-ons (Stremio protocol, one catalog each).
# Each entry: { "base": "https://your-addon.example", "config": "realdebrid={token}", "label": "MyAddon" }
# The {token} placeholder is replaced with the user's Real-Debrid token per request.
# EXTRA_ADDONS=[{"base":"https://your-addon.example","config":"realdebrid={token}","label":"MyAddon"}]

# Optional: restrict the subtitle search to other languages (default en). Comma-list.
# OS_LANGUAGES=en,es